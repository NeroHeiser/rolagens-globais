<div class="rolagens-globais-manager">
  <header class="manager-header">
    <div class="header-info">
      <h2>{{localize "ROLAGENS_GLOBAIS.ManagerTitle"}}</h2>
      <p class="subtitle">{{localize "ROLAGENS_GLOBAIS.Manager.HeaderSubtitle"}}</p>
      <div class="system-badge">
        <i class="fas fa-shield-alt"></i> 
        <span>{{localize "ROLAGENS_GLOBAIS.Manager.SystemDetected"}} <strong>{{systemName}}</strong></span>
      </div>
    </div>
  </header>

  <!-- Navegação de Abas -->
  <nav class="manager-tabs">
    <button type="button" class="tab-item {{#if (eq activeTab 'madness')}}active{{/if}}" data-action="setTab" data-tab="madness">
      <i class="fas fa-brain"></i> {{localize "ROLAGENS_GLOBAIS.Manager.TabMadness"}}
    </button>
    <button type="button" class="tab-item {{#if (eq activeTab 'rules')}}active{{/if}}" data-action="setTab" data-tab="rules">
      <i class="fas fa-dice-d20"></i> {{localize "ROLAGENS_GLOBAIS.Manager.TabRules"}}
    </button>
  </nav>

  <main class="manager-body">
    <!-- ABA 1: MODO LOUCURA (INTERCEPTAÇÃO PRÉ-ATAQUE) -->
    {{#if (eq activeTab "madness")}}
      <section class="tab-pane tab-madness">
        <!-- Hero Box do Modo Loucura -->
        <div class="madness-status-card {{#if madnessEnabled}}status-card-active{{else}}status-card-inactive{{/if}}">
          <div class="status-info">
            <div class="status-icon">
              <i class="fas {{#if madnessEnabled}}fa-brain fa-spin-pulse{{else}}fa-moon{{/if}}"></i>
            </div>
            <div class="status-text">
              <h3>{{#if madnessEnabled}}{{localize "ROLAGENS_GLOBAIS.Madness.StatusActive"}}{{else}}{{localize "ROLAGENS_GLOBAIS.Madness.StatusInactive"}}{{/if}}</h3>
              <p>
                {{#if madnessEnabled}}
                  Ataques e magias selecionados serão <strong>interceptados</strong> e substituídos pela Tabela de Loucura.
                {{else}}
                  O sistema de ataque e magias padrão do D&D 5e está operando normalmente (rolando d20 contra CA).
                {{/if}}
              </p>
            </div>
          </div>
          <button type="button" class="btn-toggle-madness {{#if madnessEnabled}}btn-active{{else}}btn-inactive{{/if}}" data-action="toggleMadness">
            <i class="fas {{#if madnessEnabled}}fa-power-off{{else}}fa-play{{/if}}"></i>
            <span>{{#if madnessEnabled}}{{localize "ROLAGENS_GLOBAIS.Madness.ToggleOff"}}{{else}}{{localize "ROLAGENS_GLOBAIS.Madness.ToggleOn"}}{{/if}}</span>
          </button>
        </div>

        <!-- Formulário de Configuração da Loucura -->
        <form class="madness-config-form">
          <fieldset class="rule-section">
            <legend><i class="fas fa-th-list"></i> {{localize "ROLAGENS_GLOBAIS.Madness.SelectTable"}}</legend>
            <div class="form-group">
              <label for="madness-tableId">{{localize "ROLAGENS_GLOBAIS.Madness.SelectTable"}}</label>
              <div class="form-fields">
                <select id="madness-tableId" name="tableId">
                  <option value="">-- Selecione uma Tabela Rolável --</option>
                  {{#each tables as |tbl|}}
                    <option value="{{tbl.id}}" {{#if (eq tbl.id ../madnessConfig.tableId)}}selected{{/if}}>{{tbl.name}}</option>
                  {{/each}}
                </select>
              </div>
              <p class="notes">{{localize "ROLAGENS_GLOBAIS.Madness.SelectTableHint"}}</p>
            </div>
          </fieldset>

          <fieldset class="rule-section">
            <legend><i class="fas fa-filter"></i> {{localize "ROLAGENS_GLOBAIS.Madness.Filters"}}</legend>
            
            <div class="form-group checkbox-group">
              <label>
                <input type="checkbox" name="interceptMelee" {{#if madnessConfig.interceptMelee}}checked{{/if}}>
                <span><i class="fas fa-sword"></i> {{localize "ROLAGENS_GLOBAIS.Madness.InterceptMelee"}}</span>
              </label>
            </div>

            <div class="form-group checkbox-group">
              <label>
                <input type="checkbox" name="interceptRanged" {{#if madnessConfig.interceptRanged}}checked{{/if}}>
                <span><i class="fas fa-bow-arrow"></i> {{localize "ROLAGENS_GLOBAIS.Madness.InterceptRanged"}}</span>
              </label>
            </div>

            <div class="form-group checkbox-group">
              <label>
                <input type="checkbox" name="interceptSpells" {{#if madnessConfig.interceptSpells}}checked{{/if}}>
                <span><i class="fas fa-wand-magic-sparkles"></i> {{localize "ROLAGENS_GLOBAIS.Madness.InterceptSpells"}}</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="rule-section">
            <legend><i class="fas fa-comment-alt"></i> {{localize "ROLAGENS_GLOBAIS.Rule.DeliverySection"}}</legend>

            <div class="form-group">
              <label for="madness-visibility">{{localize "ROLAGENS_GLOBAIS.Madness.Visibility"}}</label>
              <div class="form-fields">
                <select id="madness-visibility" name="visibility">
                  <option value="public" {{#if (eq madnessConfig.visibility "public")}}selected{{/if}}>{{localize "ROLAGENS_GLOBAIS.Rule.VisPublic"}}</option>
                  <option value="whisper_gm" {{#if (eq madnessConfig.visibility "whisper_gm")}}selected{{/if}}>{{localize "ROLAGENS_GLOBAIS.Rule.VisWhisperGM"}}</option>
                  <option value="blind" {{#if (eq madnessConfig.visibility "blind")}}selected{{/if}}>{{localize "ROLAGENS_GLOBAIS.Rule.VisBlind"}}</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="madness-flavor">{{localize "ROLAGENS_GLOBAIS.Madness.Flavor"}}</label>
              <div class="form-fields">
                <input type="text" id="madness-flavor" name="flavor" value="{{madnessConfig.flavor}}" placeholder="{{localize 'ROLAGENS_GLOBAIS.Madness.FlavorPlaceholder'}}">
              </div>
              <p class="notes">Use <code>{actor}</code> para o nome do personagem e <code>{item}</code> para a arma/magia.</p>
            </div>
          </fieldset>

          <div class="madness-actions">
            <button type="button" class="btn-save-madness" data-action="saveMadnessConfig">
              <i class="fas fa-save"></i> {{localize "ROLAGENS_GLOBAIS.Madness.SaveConfig"}}
            </button>
            <button type="button" class="btn-test-madness" data-action="testMadnessDraw">
              <i class="fas fa-dice"></i> {{localize "ROLAGENS_GLOBAIS.Madness.TestDraw"}}
            </button>
          </div>
        </form>
      </section>
    {{/if}}

    <!-- ABA 2: ROLAGENS EXTRAS GLOBAIS (REATIVAS) -->
    {{#if (eq activeTab "rules")}}
      <section class="tab-pane tab-rules">
        <div class="rules-toolbar">
          <button type="button" class="btn-preset" data-action="loadPresets">
            <i class="fas fa-bolt"></i> {{localize "ROLAGENS_GLOBAIS.Manager.LoadPresets"}}
          </button>
          <button type="button" class="btn-add" data-action="addRule">
            <i class="fas fa-plus"></i> {{localize "ROLAGENS_GLOBAIS.Manager.AddRule"}}
          </button>
        </div>

        {{#if rules.length}}
          <table class="rules-table">
            <thead>
              <tr>
                <th class="col-status">Status</th>
                <th class="col-name">{{localize "ROLAGENS_GLOBAIS.Rule.Name"}}</th>
                <th class="col-trigger">Gatilho</th>
                <th class="col-effect">Efeito Extra</th>
                <th class="col-vis">Visibilidade</th>
                <th class="col-actions">Ações</th>
              </tr>
            </thead>
            <tbody>
              {{#each rules as |rule|}}
                <tr class="rule-row {{#unless rule.enabled}}row-disabled{{/unless}}" data-rule-id="{{rule.id}}">
                  <td class="col-status">
                    <button type="button" class="btn-toggle {{#if rule.enabled}}active{{else}}inactive{{/if}}" data-action="toggleRule" data-rule-id="{{rule.id}}" title="Alternar status">
                      <i class="fas {{#if rule.enabled}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i>
                    </button>
                  </td>
                  <td class="col-name">
                    <strong>{{rule.name}}</strong>
                    {{#if rule.flavor}}
                      <span class="rule-subtext">{{rule.flavor}}</span>
                    {{/if}}
                  </td>
                  <td class="col-trigger">
                    <span class="badge-trigger">{{rule.triggerSummary}}</span>
                  </td>
                  <td class="col-effect">
                    <span class="badge-effect badge-{{rule.effectType}} {{#if rule.hasConfigError}}badge-warning{{/if}}">
                      {{#if (eq rule.effectType "table")}}<i class="fas fa-th-list"></i> Tabela: {{rule.targetName}}{{/if}}
                      {{#if (eq rule.effectType "roll")}}<i class="fas fa-dice"></i> Fórmula: {{rule.formula}}{{/if}}
                      {{#if (eq rule.effectType "macro")}}<i class="fas fa-code"></i> Macro: {{rule.targetName}}{{/if}}
                    </span>
                  </td>
                  <td class="col-vis">
                    <span class="badge-vis">{{rule.visibilityLabel}}</span>
                  </td>
                  <td class="col-actions">
                    <button type="button" class="btn-icon" data-action="editRule" data-rule-id="{{rule.id}}" title="{{localize 'ROLAGENS_GLOBAIS.Manager.Edit'}}">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="btn-icon btn-delete" data-action="deleteRule" data-rule-id="{{rule.id}}" title="{{localize 'ROLAGENS_GLOBAIS.Manager.Delete'}}">
                      <i class="fas fa-trash"></i>
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <div class="empty-state">
            <i class="fas fa-dice-d20 empty-icon"></i>
            <p>{{localize "ROLAGENS_GLOBAIS.Manager.NoRules"}}</p>
          </div>
        {{/if}}
      </section>
    {{/if}}
  </main>
</div>
