<form class="rolagens-globais-item-dialog" autocomplete="off">
  <div class="item-header-preview">
    <img src="{{item.img}}" width="40" height="40" alt="{{item.name}}"/>
    <h3>{{item.name}}</h3>
  </div>

  <p class="notes">
    Personalize como este item específico interage com o sistema de Rolagens Globais e com o Modo Loucura.
  </p>

  <div class="form-group">
    <label for="item-ignoreGlobal">{{localize "ROLAGENS_GLOBAIS.ItemConfig.IgnoreGlobal"}}</label>
    <div class="form-fields">
      <input type="checkbox" id="item-ignoreGlobal" name="ignoreGlobal" {{#if ignoreGlobal}}checked{{/if}} />
    </div>
  </div>

  <div class="form-group">
    <label for="item-ignoreMadness">{{localize "ROLAGENS_GLOBAIS.ItemConfig.IgnoreMadness"}}</label>
    <div class="form-fields">
      <input type="checkbox" id="item-ignoreMadness" name="ignoreMadness" {{#if ignoreMadness}}checked{{/if}} />
    </div>
  </div>

  <footer class="dialog-buttons">
    <button type="button" class="btn-cancel" data-action="cancel">
      <i class="fas fa-times"></i> {{localize "ROLAGENS_GLOBAIS.Rule.Cancel"}}
    </button>
    <button type="submit" class="btn-save" data-action="save">
      <i class="fas fa-save"></i> {{localize "ROLAGENS_GLOBAIS.ItemConfig.Save"}}
    </button>
  </footer>
</form>
